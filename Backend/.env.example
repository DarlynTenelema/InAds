# =============================================================================
# InAds Backend (Golang) — Plantilla de Variables de Entorno (.env.example)
# Copia este archivo a Backend/.env y completa los valores reales.
# =============================================================================

APP_ENV=development
PORT=8080
ALLOWED_ORIGINS=http://localhost:3000

DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-us-east-1.pooler.supabase.com:5432/postgres

SUPABASE_URL=https://[PROJECT_REF].supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SUPABASE_JWT_SECRET=your_supabase_jwt_secret

GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

API_KEY_HMAC_SECRET=replace_with_64_char_random_hex_secret
DEVICE_HASH_SALT=replace_with_32_char_random_salt

ADMIN_EMAILS=admin@example.com

COST_PER_VERIFIED_USER=0.15
INFLUENCER_REWARD=0.10
PLATFORM_FEE=0.05
MIN_PAYOUT_AMOUNT=100.00
MIN_SESSIONS_FOR_VERIFICATION=3
FRAUD_MAX_CLAIMS_PER_SUBNET_HOUR=50
RATE_LIMIT_REQUESTS_PER_MINUTE=120

